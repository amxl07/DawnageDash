# Copy to .env and fill from the repo-root .env (VITE_SUPABASE_* keys).
# ANON key only — never SUPABASE_SERVICE_ROLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional error reporting in release/preview builds; development is disabled.
# Public client DSN only. Keep SENTRY_AUTH_TOKEN in the build secret store.
EXPO_PUBLIC_SENTRY_DSN=
# Build environment selects separate app identities: development / preview / production.
# APP_VARIANT=development
# Optional source-map plugin configuration (build environment): SENTRY_ORG, SENTRY_PROJECT.
