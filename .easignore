# EAS archives this Git repository root, even when invoked from mobile/.
# Keep the mobile app and its shared runtime contract only.
/*
!/.easignore
!/mobile
!/shared

# .easignore replaces .gitignore for uploads, so exclusions are explicit.
**/node_modules
**/.git
**/.DS_Store
**/.env*
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision
**/credentials.json
**/google-service-account*.json
**/*debug*.log
**/*.tsbuildinfo
/mobile/.expo
/mobile/.kotlin
/mobile/.metro-health-check*
/mobile/android
/mobile/ios
/mobile/dist
/mobile/web-build
/mobile/coverage
/mobile/.maestro
/mobile/docs
/mobile/plans
/mobile/animation-plans
**/__tests__
**/*.test.*
